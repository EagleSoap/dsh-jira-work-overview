{
  "name": "dsh-jira-work-overview",
  "version": "0.16.2",
  "description": "Show your Jira work items and their workflow status inside DeepSeek Harness (DSH) · 在 DSH 里查看我的 Jira 工作项与完成状态",
  "license": "MIT",
  "author": "Zhaohong Fei",
  "keywords": [
    "dsh",
