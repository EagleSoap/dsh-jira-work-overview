    "jira",
    "atlassian",
    "sprint",
    "agile",
    "dashboard"
  ],
  "homepage": "https://github.com/EagleSoap/dsh-jira-work-overview#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EagleSoap/dsh-jira-work-overview.git"
  },
  "bugs": {
    "url": "https://github.com/EagleSoap/dsh-jira-work-overview/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
